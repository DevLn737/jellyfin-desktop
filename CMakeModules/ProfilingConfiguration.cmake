option(JMP_DIAGNOSTIC "Build the separate on-demand localhost Tracy portable" OFF)
if(JMP_DIAGNOSTIC)
  if(NOT CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo" AND NOT CMAKE_CONFIGURATION_TYPES)
    message(FATAL_ERROR "Diagnostic portable requires RelWithDebInfo")
  endif()
  include(FetchContent)
  foreach(flag TRACY_ENABLE TRACY_STATIC TRACY_ON_DEMAND TRACY_ONLY_LOCALHOST
      TRACY_NO_BROADCAST TRACY_NO_FRAME_IMAGE TRACY_NO_CODE_TRANSFER TRACY_NO_SAMPLING
      TRACY_NO_CONTEXT_SWITCH TRACY_NO_SYSTEM_TRACING TRACY_NO_CALLSTACK
      TRACY_NO_VSYNC_CAPTURE)
    set(${flag} ON CACHE BOOL "Locked diagnostic policy" FORCE)
  endforeach()
  set(TRACY_NO_EXIT OFF CACHE BOOL "Do not block shutdown waiting for a viewer" FORCE)
  if(NOT JMP_TRACY_SHA256 MATCHES "^[a-fA-F0-9]+$" OR NOT JMP_TRACY_URL)
    message(FATAL_ERROR "Tracy must be locked by URL and SHA256 in build-manifest.json")
  endif()
  set(JMP_TRACY_ARCHIVE "" CACHE FILEPATH "Verified local Tracy archive; its locked SHA256 is still enforced")
  set(_tracy_source "${JMP_TRACY_URL}")
  if(JMP_TRACY_ARCHIVE)
    set(_tracy_source "${JMP_TRACY_ARCHIVE}")
  endif()
  set(TRACY_PLATFORM_HEADER "${PROJECT_SOURCE_DIR}/src/profiling/TracyPrivacy.h" CACHE STRING "Redacted diagnostic user identity" FORCE)
  FetchContent_Declare(tracy URL "${_tracy_source}" URL_HASH "SHA256=${JMP_TRACY_SHA256}" EXCLUDE_FROM_ALL)
  FetchContent_MakeAvailable(tracy)
endif()
