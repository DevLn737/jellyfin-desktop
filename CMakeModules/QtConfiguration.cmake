if(QTROOT)
  list(PREPEND CMAKE_PREFIX_PATH "${QTROOT}")
endif()

# Qt and the separately distributed WebEngine extension share one tested patch.
# A newer 6.11 patch requires the release memory qualification.
if(NOT JMP_QT_VERSION MATCHES "^6\\.11\\.[0-9]+$")
  message(FATAL_ERROR "The qualified Qt/WebEngine version must be a 6.11 patch from BuildManifest")
endif()
set(REQUIRED_QT_VERSION "${JMP_QT_VERSION}")
set(components Core Gui Network Concurrent WebChannel Qml Quick Xml Widgets OpenGL WebEngineCore WebEngineQuick)
if(LINUX_DBUS)
  list(APPEND components DBus)
endif()
find_package(Qt6 ${REQUIRED_QT_VERSION} EXACT REQUIRED COMPONENTS ${components})
foreach(COMP IN LISTS components)
  list(APPEND QT6_LIBRARIES Qt6::${COMP})
endforeach()
if(NOT Qt6WebEngineCore_VERSION VERSION_EQUAL Qt6Core_VERSION)
  message(FATAL_ERROR "Qt WebEngine and Qt must use the same qualified 6.11 patch")
endif()
message(STATUS "Qt version: ${Qt6Core_VERSION}; WebEngine: ${Qt6WebEngineCore_VERSION}")
