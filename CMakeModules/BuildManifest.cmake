include_guard(GLOBAL)

get_filename_component(_jmp_source_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${_jmp_source_root}/build-manifest.json" _jmp_manifest)
string(JSON JMP_MANIFEST_SCHEMA GET "${_jmp_manifest}" schemaVersion)
if(NOT JMP_MANIFEST_SCHEMA EQUAL 1)
  message(FATAL_ERROR "Unsupported build manifest schema")
endif()
string(JSON JMP_APP_VERSION GET "${_jmp_manifest}" appVersion)
string(JSON JMP_PACKAGE_VERSION GET "${_jmp_manifest}" packageVersion)
string(JSON JMP_RELEASE_REPOSITORY GET "${_jmp_manifest}" releaseRepository)
string(JSON JMP_QT_VERSION GET "${_jmp_manifest}" qt version)
string(JSON JMP_MIN_WINDOWS_BUILD GET "${_jmp_manifest}" windows minimumBuild)
string(JSON JMP_WIX_VERSION GET "${_jmp_manifest}" tools wix version)
string(JSON JMP_VCREDIST_VERSION GET "${_jmp_manifest}" tools vcRedist version)
string(JSON JMP_TRACY_URL GET "${_jmp_manifest}" tracy url)
string(JSON JMP_TRACY_SHA256 GET "${_jmp_manifest}" tracy sha256)
string(JSON JMP_MPV_URL GET "${_jmp_manifest}" mpv url)
string(JSON JMP_MPV_VERSION GET "${_jmp_manifest}" mpv version)
string(JSON JMP_MPV_SHA256 GET "${_jmp_manifest}" mpv sha256)
string(JSON JMP_QT_RELEASE_QUALIFIED GET "${_jmp_manifest}" qt qualification qualified)
if(NOT JMP_APP_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[1-9][0-9]*)?$")
  message(FATAL_ERROR "App version must be a stable SemVer or an rc.N candidate")
endif()
if(NOT JMP_PACKAGE_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
  message(FATAL_ERROR "MSI package version must have three numeric parts")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_jmp_source_root}/build-manifest.json")
