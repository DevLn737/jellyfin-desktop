cmake_minimum_required(VERSION 3.31.6)
foreach(_required DEPLOYMENT_DIR STAGING_DIR OUTPUT_ZIP RUNTIME_DIR MANIFEST_PATH)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "${_required} is required")
  endif()
endforeach()
if(NOT EXISTS "${RUNTIME_DIR}/vcruntime140.dll")
  message(FATAL_ERROR "Portable distributions require the x64 Microsoft CRT")
endif()
# Never reuse a directory containing a user's portable profile.
if(EXISTS "${STAGING_DIR}/data" OR EXISTS "${STAGING_DIR}/cache")
  message(FATAL_ERROR "Portable staging contains user data; use a fresh staging directory")
endif()
file(MAKE_DIRECTORY "${STAGING_DIR}")
if(DIAGNOSTIC)
  # Tracy is linked statically. Older configurations installed development
  # headers/export files here; never distribute those absolute build paths.
  get_filename_component(_source_root "${MANIFEST_PATH}" DIRECTORY)
  file(REAL_PATH "${_source_root}" _source_real)
  file(REAL_PATH "${STAGING_DIR}" _stage_real)
  string(FIND "${_stage_real}" "${_source_real}/" _in_checkout)
  if(NOT _in_checkout EQUAL 0)
    message(FATAL_ERROR "Diagnostic staging must be inside this checkout")
  endif()
  foreach(_development_directory include lib)
    if(EXISTS "${STAGING_DIR}/${_development_directory}")
      file(REAL_PATH "${STAGING_DIR}/${_development_directory}" _development_real)
      string(FIND "${_development_real}" "${_stage_real}/" _in_stage)
      if(NOT _in_stage EQUAL 0)
        message(FATAL_ERROR "Development staging directory resolves outside the staging root")
      endif()
      file(REMOVE_RECURSE "${_development_real}")
    endif()
  endforeach()
  set(_development_excludes PATTERN "include" EXCLUDE PATTERN "lib" EXCLUDE)
endif()
file(COPY "${DEPLOYMENT_DIR}/" DESTINATION "${STAGING_DIR}"
  PATTERN "*.pdb" EXCLUDE PATTERN "data" EXCLUDE PATTERN "cache" EXCLUDE ${_development_excludes})
file(GLOB _crt_dlls "${RUNTIME_DIR}/*.dll")
file(COPY ${_crt_dlls} DESTINATION "${STAGING_DIR}")
if(ISOLATED_PROFILE)
  file(WRITE "${STAGING_DIR}/portable" "Settings and cache are stored beside this executable in data/ and cache/.\n")
elseif(EXISTS "${STAGING_DIR}/portable" OR EXISTS "${STAGING_DIR}/portable.txt")
  message(FATAL_ERROR "Portable staging has a marker from a previous build; use a fresh staging directory")
endif()
file(COPY "${MANIFEST_PATH}" DESTINATION "${STAGING_DIR}")
get_filename_component(_source_root "${MANIFEST_PATH}" DIRECTORY)
file(COPY "${_source_root}/bundle/win/PORTABLE.md" DESTINATION "${STAGING_DIR}")
if(DIAGNOSTIC)
  file(WRITE "${STAGING_DIR}/DIAGNOSTIC.txt"
    "Diagnostic Tracy build. Connect a local Tracy 0.14.1 viewer on demand. A portable marker opts into isolated data; without it this executable retains AppData.\n")
endif()
# Archive paths are relative to staging so extraction puts the executable at the root.
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUTPUT_ZIP}" --format=zip -- .
  WORKING_DIRECTORY "${STAGING_DIR}" COMMAND_ERROR_IS_FATAL ANY)
