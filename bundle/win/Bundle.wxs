<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?include Global.wxi ?>
  <?include Version.wxi ?>
  <Bundle Name="$(var.ProductName)" Version="$(var.Version)" Manufacturer="Jellyfin"
          UpgradeCode="$(var.ProductUUID)" HelpUrl="$(var.JellyfinWebsiteUrl)" AboutUrl="$(var.JellyfinWebsiteUrl)"
          Copyright="Jellyfin" Tag="$(var.FullVersion)" IconSourceFile="jellyfin.ico">
    <util:RegistrySearch Id="WindowsBuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                         Value="CurrentBuildNumber" Variable="WindowsBuild" Result="value" Bitness="always64" />
    <bal:Condition Condition="WixBundleInstalled OR (VersionNT64 AND WindowsBuild &gt;= $(var.MinimumWindowsBuild))" Message="$(var.OldWindowsError)" />
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="https://github.com/DevLn737/jellyfin-desktop/blob/main/LICENSE"
                                             LogoFile="jellyfin-chevron-85.png" SuppressOptionsUI="no"
                                             LaunchTarget="[InstallFolder]\JellyfinMediaPlayer.exe" LaunchWorkingFolder="[InstallFolder]" />
    </BootstrapperApplication>
    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]Jellyfin\Jellyfin Media Player" bal:Overridable="yes" />
    <util:RegistrySearch Id="PreviousInstallFolderSearch" Root="HKCU" Key="Software\Jellyfin\Jellyfin Media Player"
                         Value="InstallFolder" Variable="PreviousInstallFolder" />
    <util:DirectorySearch Path="[PreviousInstallFolder]" Variable="InstallFolder" After="PreviousInstallFolderSearch"
                          Condition="PreviousInstallFolder" />
    <Variable Name="AddDesktopShortcut" Type="numeric" Value="1" bal:Overridable="yes" />
    <util:RegistrySearch Id="VCRuntimeSearch" Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
                         Value="Version" Variable="VCRuntimeVersion" Result="value" Bitness="always64" />
    <Chain>
      <ExePackage Id="VCRedist" SourceFile="$(var.VCRedistPath)" Name="VC_redist.x64.exe"
                  DetectCondition="VCRuntimeVersion AND VCRuntimeVersion &gt;= v$(var.VCRedistVersion)"
                  InstallArguments="/install /quiet /norestart" RepairArguments="/repair /quiet /norestart"
                  PerMachine="yes" Permanent="yes" Vital="yes" Compressed="yes">
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>
      <MsiPackage Id="JellyfinMediaPlayerMsi" SourceFile="$(var.MsiPath)" Compressed="yes" Vital="yes" ForcePerMachine="yes">
        <MsiProperty Name="INSTALLLOCATION" Value="[InstallFolder]" />
        <MsiProperty Name="ADDDESKTOPSHORTCUT" Value="[AddDesktopShortcut]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
