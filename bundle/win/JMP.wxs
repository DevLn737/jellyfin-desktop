<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?include Global.wxi ?>
  <?include Version.wxi ?>
  <Package Name="$(var.ProductName)" Manufacturer="Jellyfin" Language="1033"
           Version="$(var.Version)" UpgradeCode="$(var.ProductUUID)" Scope="perMachine" InstallerVersion="500">
    <SummaryInformation Description="$(var.ProductDesc)" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="$(var.NewerVersionError)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="WINDOWSBUILD">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= $(var.MinimumWindowsBuild))" Message="$(var.OldWindowsError)" />
    <Property Id="INSTALLLOCATION" Secure="yes">
      <RegistrySearch Id="ExistingInstallFolder" Root="HKCU" Key="Software\Jellyfin\Jellyfin Media Player"
                      Name="InstallFolder" Type="raw" />
    </Property>
    <Property Id="ADDDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Icon Id="JellyfinMediaPlayerIcon" SourceFile="jellyfin.ico" />
    <?include ControlPanel.wxi ?>
    <util:CloseApplication Id="JellyfinMediaPlayer" Target="JellyfinMediaPlayer.exe"
                           CloseMessage="yes" ElevatedCloseMessage="yes" RebootPrompt="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="JellyfinFolder" Name="Jellyfin">
        <Directory Id="INSTALLLOCATION" Name="Jellyfin Media Player" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="JellyfinStartMenuFolder" Name="Jellyfin Media Player">
        <Component Id="JellyfinMediaPlayerShortcuts" Guid="*">
          <Shortcut Id="JellyfinMediaPlayerExeShortcut" Name="Jellyfin Media Player"
                    Description="Jellyfin Media Player for Windows" Target="[INSTALLLOCATION]JellyfinMediaPlayer.exe"
                    WorkingDirectory="INSTALLLOCATION" />
          <RegistryValue Root="HKCU" Key="Software\Jellyfin\Jellyfin Media Player" Name="InstallFolder"
                         Type="string" Value="[INSTALLLOCATION]" KeyPath="yes" />
          <RemoveFolder Id="JellyfinStartMenuFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="ApplicationShortcutDesktop" Guid="b2a1316d-917f-433f-bd87-02ec717c2648" Condition="ADDDESKTOPSHORTCUT=1">
        <Shortcut Id="ApplicationDesktopShortcut" Name="Jellyfin Media Player"
                  Description="Desktop client for Jellyfin" Target="[INSTALLLOCATION]JellyfinMediaPlayer.exe"
                  WorkingDirectory="INSTALLLOCATION" />
        <RegistryValue Root="HKCU" Key="Software\Jellyfin\Jellyfin Media Player" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="ProductFeature" Title="Jellyfin" Level="1">
      <Files Directory="INSTALLLOCATION" Include="!(bindpath.Deployment)\**">
        <Exclude Files="!(bindpath.Deployment)\**.pdb" />
        <Exclude Files="!(bindpath.Deployment)\data\**" />
        <Exclude Files="!(bindpath.Deployment)\cache\**" />
        <Exclude Files="!(bindpath.Deployment)\portable*" />
      </Files>
      <ComponentRef Id="JellyfinMediaPlayerShortcuts" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
    </Feature>
  </Package>
</Wix>
